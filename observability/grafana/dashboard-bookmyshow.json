{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "BookMyShow — Observability",
  "tags": ["bookmyshow", "red", "jvm"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"book-my-show-backend\"}[1m])) by (uri)",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency p95 / p99 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"book-my-show-backend\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"book-my-show-backend\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate (5xx %)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"book-my-show-backend\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"book-my-show-backend\"}[5m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "JVM heap used (bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{application=\"book-my-show-backend\",area=\"heap\"})",
          "legendFormat": "heap used"
        }
      ]
    },
    {
      "id": 5,
      "title": "GC pause rate (s/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{application=\"book-my-show-backend\"}[5m]))",
          "legendFormat": "gc pause/s"
        }
      ]
    },
    {
      "id": 6,
      "title": "Booking outcomes (rate/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(bookings_initiated_total{application=\"book-my-show-backend\"}[5m])",
          "legendFormat": "initiated"
        },
        {
          "refId": "B",
          "expr": "rate(bookings_confirmed_total{application=\"book-my-show-backend\"}[5m])",
          "legendFormat": "confirmed"
        },
        {
          "refId": "C",
          "expr": "rate(bookings_cancelled_total{application=\"book-my-show-backend\"}[5m])",
          "legendFormat": "cancelled"
        },
        {
          "refId": "D",
          "expr": "rate(bookings_expired_total{application=\"book-my-show-backend\"}[5m])",
          "legendFormat": "expired"
        },
        {
          "refId": "E",
          "expr": "rate(seat_lock_contention_total{application=\"book-my-show-backend\"}[5m])",
          "legendFormat": "seat lock contention"
        }
      ]
    }
  ]
}
